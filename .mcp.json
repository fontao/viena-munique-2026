{
  "mcpServers": {
    "osm": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "osm-mcp"
      ],
      "env": {}
    },
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest",
        "--headless",
        "--output-dir",
        ".playwright-mcp",
        "--allow-unrestricted-file-access"
      ],
      "env": {}
    }
  }
}
